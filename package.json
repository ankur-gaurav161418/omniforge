{
  "name": "omniforge-monorepo",
  "version": "1.0.0",
  "description": "OmniForge - Build • Orchestrate • Supercharge AI Engineering",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "cli",
    "mcp",
    "skills",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "omniforge": "node cli/dist/index.js",
    "mcp:start": "node mcp/dist/server.js"
  },
  "keywords": [
    "omniforge",
    "ai-engineering",
    "mcp",
    "agent-framework",
    "skills",
    "prompts",
    "workflows",
    "tdd",
    "superpowers"
  ],
  "author": "OmniForge Team (Derived from obra/superpowers by Jesse Vincent)",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10",
    "prettier": "^3.2.5",
    "eslint": "^8.57.0"
  }
}
